#!/usr/bin/env sh
# Minimal launcher placeholder. In --daemon mode it stays alive for compositor autostart.
case "${1:-}" in
  --daemon) exec sh -c 'while :; do sleep 3600; done' ;;
  --show) command -v rofi >/dev/null 2>&1 && exec rofi -show drun || exec sh -c 'printf "NestLauncher placeholder: install rofi or implement native launcher.\n"' ;;
  *) exec sh -c 'printf "NestLauncher placeholder\n"' ;;
esac
